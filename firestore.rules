rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hackathon rules: any signed-in (anonymous) user can read/write groups.
    // Tighten before production.
    match /groups/{groupId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false; // deletion is server-side only (Cloud Functions)

      match /members/{memberId} {
        allow read, create, update: if request.auth != null;
        allow delete: if false;
      }
      match /missions/{missionId} {
        allow read: if request.auth != null;
        allow write: if false; // missions are created by Cloud Functions only
      }
      match /photos/{photoId} {
        allow read, create, update: if request.auth != null;
        allow delete: if false;
      }
    }
  }
}
